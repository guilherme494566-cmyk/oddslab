{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/acesso.js": {
      "includeFiles": "{data/**,tools/**}"
    },
    "api/admin.js": {
      "includeFiles": "{data/**,tools/**}"
    },
    "api/evento.js": {
      "includeFiles": "{data/**,tools/**}"
    }
  }
}